# Database
DATABASE_URL="mysql2://user:password@localhost:3306/ticket_db"

# File Upload Directory
UPLOAD_DIR="./server/uploads"

# Object storage S3/MinIO (opsional). Jika S3_ENDPOINT kosong, file disimpan di UPLOAD_DIR.
# Jalankan MinIO: docker compose --profile s3 up -d minio  (API :9100, konsol :9101)
# S3_ENDPOINT="http://localhost:9100"      # app di Docker compose: http://minio:9000
# S3_BUCKET="it-ticketing"                 # dibuat otomatis bila belum ada
# S3_ACCESS_KEY="minioadmin"
# S3_SECRET_KEY="ganti-dengan-secret-kuat"
# S3_REGION="us-east-1"
# S3_FORCE_PATH_STYLE="true"               # true untuk MinIO

# JWT Authentication
JWT_SECRET="generate-a-random-secret-string"
JWT_EXPIRES_IN="7d"
NODE_ENV="production"

# Password awal admin sysadmin@company.co.id, hanya dipakai oleh `pnpm seed` saat admin belum ada.
# Kosong = dibuat acak dan dicetak sekali di output seeder. Ganti setelah login pertama.
# ADMIN_PASSWORD="isi-password-kuat"

# Tampilan akun demo di halaman login: production (disembunyikan) | staging | development.
# Default: production. Cukup ubah env ini lalu restart container, tanpa rebuild.
NUXT_PUBLIC_APP_ENV="production"

# DB terpisah untuk test integrasi MCP (nama harus memuat "test")
DATABASE_URL_TEST="mysql2://user:password@localhost:3306/ticket_db_test"
